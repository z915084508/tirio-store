{% assign selected_variant = product.selected_or_first_available_variant %}
<section class="container product"><div class="gallery">{% for image in product.images %}{{ image | image_url: width: 1400 | image_tag: widths: '400,800,1400', loading: 'lazy' }}{% else %}<div class="card-media">{{ 'product-1' | placeholder_svg_tag }}</div>{% endfor %}</div><div><p class="eyebrow">{{ product.vendor | escape }}</p><h1>{{ product.title | escape }}</h1><p class="price">{% if product.price_varies %}{{ product.price_min | money }} – {{ product.price_max | money }}{% else %}{{ product.price | money }}{% endif %}</p><div class="rte">{{ product.description }}</div>
{% if settings.catalog_mode %}<p class="empty">{{ 'products.catalog_notice' | t }}</p>{% else %}
{% form 'product', product, class: 'product-form' %}{{ form.errors | default_errors }}<label for="Variant-{{ section.id }}">{{ 'products.variant' | t }}</label><select id="Variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant.id == selected_variant.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} · {{ 'products.sold_out' | t }}{% endunless %}</option>{% endfor %}</select><label for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1"><button class="button" type="submit"{% unless product.available %} disabled{% endunless %}>{% if product.available %}{{ 'products.add' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</button>{% endform %}{% endif %}
{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% when 'details' %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }}</summary><div class="rte">{{ block.settings.text }}</div></details>{% endcase %}{% endfor %}</div></section>
{% schema %}
{
  "name": "main product",
  "settings": [],
  "blocks": [
    {
      "type": "details",
      "name": "Product information",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Información del producto"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Confirma escala, materiales y dimensiones antes del lanzamiento.</p>"
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
