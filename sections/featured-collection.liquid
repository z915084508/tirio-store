{% assign featured_collection = section.settings.collection %}
{% if featured_collection != blank or request.design_mode %}
  <section class="container section featured-collection" aria-labelledby="FeaturedHeading-{{ section.id }}">
    <div class="section-heading">
      <h2 id="FeaturedHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.show_view_all and featured_collection != blank %}
        <a class="button" href="{{ featured_collection.url }}">
          {{ section.settings.view_all_label | default: 'Ver todo' | escape }} <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>
    {% if featured_collection == blank %}
      <p class="empty">{{ 'general.select_featured_collection' | t }}</p>
    {% elsif featured_collection.products.size == 0 %}
      <p class="empty">{{ 'general.featured_collection_empty' | t }}</p>
    {% else %}
      <ul class="grid product-grid" role="list">
        {% for product in featured_collection.products limit: section.settings.limit %}
          <li>{% render 'product-card', card_product: product %}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </section>
{% endif %}
{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Listos para tu colección"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Máximo de productos",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Mostrar botón Ver todo",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto del botón",
      "default": "Ver todo"
    }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
