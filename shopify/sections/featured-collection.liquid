<section class="container section"><div class="section-heading"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.collection != blank %}<a href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }} →</a>{% endif %}</div><div class="grid">{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', card_product: product %}{% else %}{% assign titles = 'Modelos de aviones,Figuras TOAM,Flight Logbook,Accesorios de aviación' | split: ',' %}{% for title in titles %}{% render 'product-card', placeholder_title: title %}{% endfor %}{% endfor %}</div></section>
{% schema %}
{
  "name": "featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Listos para tu colección"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Product limit",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
