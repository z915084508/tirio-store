{% if card_product != blank %}<a class="card" href="{{ card_product.url }}"><div class="card-media">{% if card_product.featured_image %}{{ card_product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '240,400,700' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div><h3>{{ card_product.title | escape }}</h3><span class="muted">{{ card_product.price | money }}{% unless card_product.available %} · {{ 'products.sold_out' | t }}{% endunless %}</span></a>{% else %}<div class="card"><div class="card-media">{{ 'product-1' | placeholder_svg_tag }}</div><h3>{{ placeholder_title | default: 'Aviation collectible' | escape }}</h3><span class="tag muted">{{ 'general.placeholder' | t }}</span></div>{% endif %}
